{
  "name": "lumine-sftp",
  "version": "0.1.0",
  "description": "Simple, secure SFTP client for Windows and macOS with QR-code server import",
  "main": "./out/main/index.js",
  "author": "Lumine",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Megumi1608/LumineSFTP.git"
  },
  "homepage": "https://github.com/Megumi1608/LumineSFTP",
  "bugs": {
    "url": "https://github.com/Megumi1608/LumineSFTP/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/sftp.integration.test.ts",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "release:win": "npm run build && electron-builder --win --publish always",
    "release:mac": "npm run build && electron-builder --mac --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "jsqr": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
